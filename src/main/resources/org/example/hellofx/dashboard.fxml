<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.hellofx.HelloController"
      spacing="30"
      style="-fx-background-color: linear-gradient(to bottom right, #0a0015, #120025, #0a0015);">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Robot Simulator Dashboard"
               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #c084fc; -fx-effect: dropshadow(gaussian, #a855f780, 15, 0.5, 0, 2);"/>
        <Label text="Welcome to your simulation control center"
               style="-fx-font-size: 15px; -fx-text-fill: #a0a0c0;"/>
    </VBox>

    <!-- Main Action Cards -->
    <HBox spacing="30" alignment="CENTER">

        <!-- Create Factory Layout Card -->
        <VBox fx:id="createCard" alignment="CENTER" spacing="18" prefWidth="320" prefHeight="280"
              style="-fx-background-color: rgba(30,20,60,0.75); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #6b21a8; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, #7c3aed60, 18, 0.4, 0, 4); -fx-padding: 24;">
            <Label text="🏭" style="-fx-font-size: 60px;"/>
            <Label text="Create Factory Layout"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e0e0ff;"/>
            <Label text="Design and configure your factory layouts"
                   style="-fx-font-size: 13px; -fx-text-fill: #b0b0d0; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Button text="Create" onAction="#switchScene2"
                    style="-fx-background-color: #6d28d9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12 32; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, #a855f760, 12, 0.4, 0, 2); prefWidth: 240;"/>
        </VBox>

        <!-- View Summary Card -->
        <VBox fx:id="summaryCard" alignment="CENTER" spacing="18" prefWidth="320" prefHeight="280"
              style="-fx-background-color: rgba(30,20,60,0.75); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #6b21a8; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, #7c3aed60, 18, 0.4, 0, 4); -fx-padding: 24;">
            <Label text="📊" style="-fx-font-size: 60px;"/>
            <Label text="View Summary"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e0e0ff;"/>
            <Label text="View statistics and recent simulation runs"
                   style="-fx-font-size: 13px; -fx-text-fill: #b0b0d0; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Button text="View Summary" onAction="#switchScene6"
                    style="-fx-background-color: #6d28d9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12 32; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, #a855f760, 12, 0.4, 0, 2); prefWidth: 240;"/>
        </VBox>

        <!-- Run Simulation Card -->
        <VBox fx:id="simulationCard" alignment="CENTER" spacing="18" prefWidth="320" prefHeight="280"
              style="-fx-background-color: rgba(30,20,60,0.75); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #6b21a8; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, #7c3aed60, 18, 0.4, 0, 4); -fx-padding: 24;">
            <Label text="▶️" style="-fx-font-size: 60px;"/>
            <Label text="Run Simulation"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e0e0ff;"/>
            <Label text="Execute simulations with your layouts and rulesets"
                   style="-fx-font-size: 13px; -fx-text-fill: #b0b0d0; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Button text="Run Simulation" onAction="#SimulationRunner"
                    style="-fx-background-color: #6d28d9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12 32; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, #a855f760, 12, 0.4, 0, 2); prefWidth: 240;"/>
        </VBox>
    </HBox>

    <!-- Quick Access Section -->
    <VBox fx:id="quickAccessCard" spacing="12"
          style="-fx-background-color: rgba(30,20,60,0.75); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #6b21a8; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, #7c3aed60, 18, 0.4, 0, 4); -fx-padding: 24;">
        <Label text="Quick Access"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #c084fc;"/>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Button text="Layouts" onAction="#switchScene4"
                    style="-fx-background-color: #4c1d95; -fx-text-fill: #e0e0ff; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button text="Rulesets" onAction="#switchScene5"
                    style="-fx-background-color: #4c1d95; -fx-text-fill: #e0e0ff; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button text="Reports" onAction="#switchScene3"
                    style="-fx-background-color: #4c1d95; -fx-text-fill: #e0e0ff; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Info hint -->
    <Label text="💬 Click the chat button in the bottom-right corner to get AI assistance"
           style="-fx-font-size: 13px; -fx-text-fill: #b0b0d0; -fx-alignment: center;"/>

</VBox>