<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="20" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hellofx.DashboardController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <Button mnemonicParsing="false" onAction="#switchScene" text="Back" />
    <!-- Header -->
    <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Summary" />
    <!-- Summary Tiles Row -->
    <HBox alignment="CENTER" spacing="20">
        <!-- Total Layouts Tile -->
        <VBox alignment="CENTER" prefHeight="120" prefWidth="200" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="Total Layouts" />
            <Label fx:id="totalLayoutsLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="0" />
        </VBox>
        <!-- Total Rulesets Tile -->
        <VBox alignment="CENTER" prefHeight="120" prefWidth="200" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="Total Rulesets" />
            <Label fx:id="totalRulesetsLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="0" />
        </VBox>
        <!-- Recent Runs Tile -->
        <VBox alignment="CENTER" prefHeight="120" prefWidth="200" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="Recent Runs" />
            <Label fx:id="recentRunsCountLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #FF9800;" text="0" />
        </VBox>
    </HBox>
    <!-- Recent Simulation Runs Section -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Recent Simulation Runs" />
        <TableView fx:id="recentRunsTable" prefHeight="300">
            <columns>
                <TableColumn fx:id="timestampColumn" prefWidth="180" text="Timestamp" />
                <TableColumn fx:id="layoutColumn" prefWidth="150" text="Layout Name" />
                <TableColumn fx:id="rulesetColumn" prefWidth="150" text="Ruleset Name" />
                <TableColumn fx:id="outcomeColumn" prefWidth="100" text="Outcome" />
                <TableColumn fx:id="detailsColumn" prefWidth="250" text="Details" />
            </columns>
        </TableView>
    </VBox>
</VBox>