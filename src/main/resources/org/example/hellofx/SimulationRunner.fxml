<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.hellofx.SimulationRunnerController"
      spacing="20" style="-fx-background-color: #f5f5f5;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header with Back Button -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button onAction="#handleBack" text="Back" 
                style="-fx-background-color: #5d6bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 5;"/>
        <Label text="Simulation Runner" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Configuration Panel -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Simulation Configuration" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <!-- Layout Selection -->
            <VBox spacing="8">
                <Label text="Select Layout" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <ComboBox fx:id="layoutComboBox" promptText="Choose a layout" prefWidth="200"/>
            </VBox>

            <!-- Ruleset Selection -->
            <VBox spacing="8">
                <Label text="Select Ruleset" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <ComboBox fx:id="rulesetComboBox" promptText="Choose a ruleset" prefWidth="200"/>
            </VBox>

            <!-- Max Attempts -->
            <VBox spacing="8">
                <Label text="Max Attempts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <Spinner fx:id="maxAttemptsSpinner" editable="true" prefWidth="150"/>
            </VBox>

            <!-- Run Button -->
            <VBox alignment="BOTTOM_LEFT">
                <Label text=" " style="-fx-font-size: 14px;"/>
                <Button fx:id="runButton" onAction="#handleRun" text="Run Simulation" 
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 30 10 30; -fx-background-radius: 5;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Simulation View -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Factory Grid -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Factory Layout" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <GridPane fx:id="factoryGrid" 
                     style="-fx-grid-lines-visible: true; -fx-background-color: #fafafa; -fx-border-color: #ddd; -fx-border-radius: 5;"
                     prefHeight="400" prefWidth="400">
                <columnConstraints>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                    <ColumnConstraints minWidth="40" prefWidth="40"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                </rowConstraints>
            </GridPane>
        </VBox>

        <!-- Move List -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" prefWidth="250">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Simulation Log" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <ListView fx:id="moveListView" 
                     style="-fx-background-color: #fafafa; -fx-border-color: #ddd; -fx-border-radius: 5;"
                     VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

</VBox>